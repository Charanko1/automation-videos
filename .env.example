# AI Office - server-only credentials
# Never commit the real .env.local file.

# OmniRoute local AI gateway (Rhea/Wri/Dira)
# Run OmniRoute at http://127.0.0.1:20128, connect at least one free provider,
# then copy the API key from OmniRoute Dashboard → Endpoints.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
# "auto" lets OmniRoute choose among connected providers.
OMNIROUTE_MODEL=auto/offline
# Optional direct model used only when auto/combos exhaust their retry budget.
# Example for a connected Kiro account: kr/claude-sonnet-4.5
OMNIROUTE_DIRECT_FALLBACK_MODEL=
# Optional. Set an image-capable OmniRoute model (for example a Pollinations image model if it appears in your local Model catalog).
# When set, AI Office tries OmniRoute for scene images and falls back to Cloudflare on failure.
OMNIROUTE_IMAGE_MODEL=

# Native Novita Kling v3.0 Standard Image-to-Video
# AI Office calls Novita directly; OmniRoute is no longer used for the video stage.
NOVITA_API_KEY=
NOVITA_BASE_URL=https://api.novita.ai
# Optional override for the native Kling v3.0 STD I2V endpoint.
NOVITA_KLING_I2V_ENDPOINT=/v3/async/kling-v3.0-std-i2v

# OpenRouter text generation (legacy/fallback adapter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Text brain routing:
# - omniroute: OmniRoute first, ChatGPT plan fallback.
# - chatgpt: ChatGPT plan first, OmniRoute fallback.
AI_OFFICE_TEXT_PROVIDER=omniroute

# ChatGPT Go subscription sharing
# OPENAI / ChatGPT auth is stored locally in .ai-office-chatgpt-auth.json

# Image provider routing:
# - auto: Cloudflare image first, then optional OmniRoute fallback.
# - omniroute: use OmniRoute only (requires OMNIROUTE_IMAGE_MODEL).
# - cloudflare: use Cloudflare only.
# - chatgpt: diagnostic only; ChatGPT subscription-sharing currently cannot use the public image_generation tool.
AI_OFFICE_IMAGE_PROVIDER=cloudflare

# Optional top-level ChatGPT mainline model for the Responses API.
# Leave blank to prefer a visible GPT-5/GPT-6 family model automatically.
CHATGPT_MAINLINE_MODEL=

# Cloudflare Workers AI image generation
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional. Default is the free-per-step SDXL-Lightning model.
CLOUDFLARE_IMAGE_MODEL=@cf/bytedance/stable-diffusion-xl-lightning
# Optional. Extra negative prompt for Gemi scene images. Leave blank to use the built-in 3D-animation exclusions.
GEMI_IMAGE_NEGATIVE_PROMPT=
