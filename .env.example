# AI Office - server-only credentials
# Never commit the real .env.local file.

# OmniRoute local AI gateway (Rhea/Wri/Dira)
# Run OmniRoute at http://127.0.0.1:20128, connect at least one free provider,
# then copy the API key from OmniRoute Dashboard → Endpoints.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
# "auto" lets OmniRoute choose among connected providers.
OMNIROUTE_MODEL=auto
# Optional. Set an image-capable OmniRoute model (for example a Pollinations image model if it appears in your local Model catalog).
# When set, AI Office tries OmniRoute for scene images and falls back to Cloudflare on failure.
OMNIROUTE_IMAGE_MODEL=

# OpenRouter text generation (legacy/fallback adapter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ChatGPT Go subscription sharing
# OPENAI / ChatGPT auth is stored locally in .ai-office-chatgpt-auth.json

# Cloudflare Workers AI image generation
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional. Default is the free-per-step SDXL-Lightning model.
CLOUDFLARE_IMAGE_MODEL=@cf/bytedance/stable-diffusion-xl-lightning
